# ════════════════════════════════════════════════════════════════════════
#  InlineComp — handmatige security-aanvullingen
#
#  Twee groepen:
#   A. Directory-access (Options + FilesMatch) — sluit info-disclosure
#      via directory-listing en plain-text serveren van .bak/.sql/etc.
#   B. PHP-runtime-instellingen (php_flag/php_value binnen lsapi_module)
#      — moeten via .htaccess want byethost leest .user.ini niet voor
#      PHP-config. Zelfde mechanisme dat cPanel gebruikt voor error_log.
#
#  LET OP: als cPanel ooit deze .htaccess regenereert (bv. bij PHP-versie-
#  wissel), wordt dit block overschreven. Bewaar de code-repo-versie als
#  je-zelf-backup zodat je 'm opnieuw kunt plakken.
# ════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
#  A. DIRECTORY- EN FILE-ACCESS
# ──────────────────────────────────────────────────────────────────────

# Geen directory-listings (cPanel Index Manager doet dit ook al, dit is
# een second-line-of-defense voor 't geval die ooit op 'Inherit' belandt).
Options -Indexes

# Dotfiles (.git, .env, .htaccess zelf, .user.ini, .DS_Store, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Backup-/editor-files en interne source/docs die plain-text geserveerd
# zouden worden (auth.php.bak zou DB-creds lekken).
<FilesMatch "\.(bak|old|orig|save|swp|swo|sql|ini|conf|ya?ml|json|log|md|py|sh|bash)$|~$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# PWA-manifesten MOETEN wel door de browser opgehaald kunnen worden. Deze
# uitzondering staat bewust NA de blokkade hierboven: bij gelijke match wint
# de laatste sectie. Geldt voor public/, coach/ en jury/.
<Files "manifest.json">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</Files>

# composer/node/env artefacten (toekomst-proof)
<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|\.env|\.env\..+)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Composer /vendor/ (PHP backend-deps voor Web Push) hoort server-side te
# blijven — PHP leest 'm via het filesystem (require __DIR__ . '/../vendor/...')
# en dat gaat niet via Apache's URL-router, dus deze block raakt dat niet.
# Vangnet voor als /vendor/ ooit per ongeluk via SFTP op de webroot belandt
# (zoals bijvoorbeeld bij de 2026-10-06-upload) — altijd 403 voor HTTP.
RewriteRule ^vendor($|/) - [F,L]

# ──────────────────────────────────────────────────────────────────────
#  Referrer-Policy: same-origin — vangnet zodat URL's met parameters
#  (person_id, competition_id, enz.) nooit als Referer naar externe
#  domeinen lekken. Interne navigatie binnen het eigen domein stuurt de
#  Referer gewoon mee (nuttig voor logs); cross-origin links/sub-resources
#  zien enkel de origin, geen path of query. Zie plan URL/log-reductie
#  2026-10-02.
# ──────────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set Referrer-Policy "same-origin"
</IfModule>

# Cache-Control-regels voor statische assets staan in app-specifieke
# .htaccess-bestanden (zie public/.htaccess), NIET root-wide. Reden: niet
# alle apps gebruiken ?v=filemtime()-cachebusting op JS/CSS (coach + check
# niet), en lange cache-tijden daar zouden updates kunnen vertragen —
# tijden/uitslagen/jury-wijzigingen moeten instant doorkomen.

# ──────────────────────────────────────────────────────────────────────
#  B. PHP-RUNTIME-INSTELLINGEN  →  via cPanel MultiPHP INI Editor (NIET hier)
#
#  Deze stonden vroeger hier als php_flag/php_admin_value binnen
#  <IfModule lsapi_module>. Op de huidige byethost/LiteSpeed-config geven
#  PHP_INI_SYSTEM-directieven (o.a. expose_php + disable_functions) via
#  .htaccess een 500 — eerder getolereerd, nu niet meer (config-drift; zie
#  ook de cPanel-waarschuwing bovenaan dit bestand). Daarom weggehaald.
#
#  Zet ze via cPanel → Software → MultiPHP INI Editor:
#     display_errors    = Off      (belangrijk: geen stacktraces naar users)
#     expose_php        = Off
#     disable_functions = exec,system,passthru,proc_open,popen,pcntl_exec
#  De session-cookie-flags worden al door de app zelf gezet (api/auth.php),
#  dus daar hoef je niets voor te doen.
# ──────────────────────────────────────────────────────────────────────
