# ════════════════════════════════════════════════════════════════════════
#  SECURITY — /uploads/ serveert ALLEEN data, nooit code
#
#  Defense-in-depth. api/upload.php laat enkel ge-whiteliste image/doc-MIMEs
#  toe en bouwt de bestandsnaam zélf (extensie uit de whitelist, niet uit de
#  user-filename), dus een .php kan hier normaal niet belanden. Onderstaande
#  is de tweede linie: mocht er ooit tóch een script-bestand in deze map
#  terechtkomen (ander code-pad, misconfig), dan kan het hier niet draaien.
#
#  LET OP: als cPanel deze .htaccess ooit regenereert, plak dit block terug
#  vanuit de code-repo.
# ════════════════════════════════════════════════════════════════════════

# 1. PHP-engine uit voor deze map (LiteSpeed/lsapi + mod_php-varianten).
<IfModule lsapi_module>
    php_flag engine off
</IfModule>
<IfModule php8_module>
    php_flag engine off
</IfModule>
<IfModule php7_module>
    php_flag engine off
</IfModule>

# 2. Backstop: elke script-extensie expliciet weigeren (403), voor 't geval
#    'engine off' door de hosting genegeerd wordt. Geen uitvoering én geen
#    plain-text source-leak.
<FilesMatch "\.(php|php[0-9]|phtml|phps|pht|phar|cgi|pl|py|sh|bash|asp|aspx|jsp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Anti stored-XSS bij DIRECT openen van een geüploade .svg/.html/.xml:
#    neutraliseer scripts via CSP en verbied MIME-sniffing. Raakt <img>-
#    weergave van SVG-logo's NIET (CSP geldt alleen bij top-level document-
#    load; in <img>-context draaien SVG-scripts sowieso al niet).
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    <FilesMatch "\.(svg|svgz|xml|html?|xhtml)$">
        Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'"
    </FilesMatch>
</IfModule>

# Logo's + sponsor-images + baan-images veranderen zelden — agressief browser-
# cachen scheelt enorm veel requests per app-open.
#
# Voor: bij elke /public/ of /coach/ app-open haalt elke browser 6-8 logo-
# bestanden op (org + sponsors + baan + baan-sponsors). Bij 5 mensen die
# tegelijk de app openen × 6 logos = 30 parallel requests in 1 seconde.
# Met EP-limit 45 op iFastNet shared hosting wordt dat snel kritiek.
#
# Na: eerste app-open laadt logos 1x, browser cached ze 30 dagen. Volgende
# bezoeken in die periode komen nooit meer bij de server. Ook bij hard-refresh
# binnen 30 dagen serveert de browser 'm uit cache (conditional request
# slechts If-Modified-Since, levert 304 op zonder PHP-cycle).

<IfModule mod_headers.c>
    <FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|ico)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png  "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/gif  "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
</IfModule>
