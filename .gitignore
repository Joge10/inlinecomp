# SFTP configuratie — bevat wachtwoorden, NOOIT committen
.vscode/sftp.json

# Database configuratie (staat buiten projectmap, voor de zekerheid)
config_inlinecomp.php
config*.php

# cPanel-gegenereerde PHP-ini (server-specifiek, hoort niet in de repo)
.user.ini

# VS Code overige instellingen (optioneel bewaren)
# .vscode/

# Claude Code werkmappen en instellingen (overal in de repo)
.claude/

# IDE-specifieke mappen
.idea/

# Python-cache (poster_gen.py e.d.)
__pycache__/
*.pyc
*.pyo

# OS rommel
.DS_Store
Thumbs.db

# Editor tijdelijke bestanden
*.swp
*.swo
*~
*.bak

# Algemene tijdelijke bestanden en logs
*.log
*.tmp

# Uploader-map: lokale test-CSVs / live MyLaps-output, niet committen
uploader/

# Werkmap voor ad-hoc gegenereerde files (PDF-rapporten, debug-scripts)
tmp/

# Diagnostic-script: lokaal werkbestand voor server-debug, bevat soms
# test-secrets. Geert houdt zelf bij dat 'ie niet op de server komt.
_diag.php

# Mail-testscript: lokaal ad-hoc testbestand, hoort niet in de repo én
# moet van de server af (zie mail-deliverability-werk).
_mailtest.php

# Composer-dependencies: gegenereerd uit composer.json/composer.lock en via
# SFTP naar de server geüpload (geen composer op de shared host). composer.json
# + composer.lock committen we WEL — die documenteren de deps (reproduceerbaar
# met `composer install`). De vendor/-map zelf (honderden files) niet.
/vendor/

# Web Push throwaway-scripts (Fase 0/1 diagnose + VAPID-keygen): niet committen,
# en van de server af halen na gebruik.
_diag_push.php
_vapid_keygen.php
vapid_keygen.php
